# Optional. Without a key the app uses OpenStreetMap tiles (or a schematic map offline).
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
# JiranLink AI server (Cloudflare Worker in worker/). Holds the Gemini key so the app never does.
VITE_AI_PROXY_URL=
# Advanced: call a provider directly from the browser (demo on your own laptop only; the key is exposed).
VITE_AI_PROVIDER=
VITE_AI_MODEL=
VITE_AI_KEY=
