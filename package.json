{
  "name": "jiranlink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "typecheck": "tsc --noEmit",
    "build:artifact": "vite build --mode single && node scripts/make-artifact.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build:pages": "tsc --noEmit && vite build --mode pages && node -e \"require('fs').writeFileSync('dist-pages/.nojekyll','')\"",
    "build:worker": "tsx scripts/build-worker.ts",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
